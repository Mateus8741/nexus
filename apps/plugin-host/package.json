{
  "name": "@nexus/plugin-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run --filter @nexus/db push"
  },
  "dependencies": {
    "@nexus/agent-protocol": "workspace:*",
    "@nexus/application": "workspace:*",
    "@nexus/auth": "workspace:*",
    "@nexus/db": "workspace:*",
    "@nexus/domain": "workspace:*",
    "@nexus/infrastructure": "workspace:*",
    "@nexus/plugin-tuya": "workspace:*",
    "@nexus/plugin-windows": "workspace:*",
    "@nexus/plugins-sdk": "workspace:*",
    "better-auth": "1.2.12",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nexus/typescript-config": "workspace:*",
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "ws": "8"
  }
}
