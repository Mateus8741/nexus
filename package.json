{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "format:docs": "prettier --write \"**/*.{md,mdx}\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5"
  }
}
